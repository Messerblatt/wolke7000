		{"id":"fbfecd58aa8924ac","type":"text","text":"# Wir fliegen durch die Wolken und wissen nicht, wonach wir suchen","x":460,"y":-187,"width":502,"height":145},
		{"id":"fc27e02163485c0d","type":"text","text":"Joyce","x":400,"y":60,"width":250,"height":60},
		{"id":"2c92dbbd545e823e","type":"text","text":"# Beginn Akt 2\n\n","x":-942,"y":-258,"width":323,"height":71},
		{"id":"4c9d414692258e3a","type":"text","text":"Der Plot ist eine Schatzsuche nach Wolke 7000","x":-905,"y":-467,"width":250,"height":100},
